[0.376829, "o", "\r\n--\r\nLicense Plate L337369\r\nMake: Honda\r\nColor: Blue\r\nOwner: Heather Billings\r\nHeight: 5'2\"\r\nWeight: 244 lbs\r\n--\r\nLicense Plate L337DV9\r\nMake: Honda\r\nColor: Blue\r\nOwner: Joe Germuska\r\nHeight: 6'2\"\r\nWeight: 164 lbs\r\n--\r\nLicense Plate L3375A9\r\nMake: Honda\r\nColor: Blue\r\nOwner: Jeremy Bowers\r\nHeight: 6'1\"\r\nWeight: 204 lbs\r\n--\r\nLicense Plate L337WR9\r\nMake: Honda\r\nColor: Blue\r\nOwner: Jacqui Maher\r\nHeight: 6'2\"\r\nWeight: 130 lbs\r\n\u001b[?2004h\u001b[32mstudent\u001b[33m@\u001b[34mi.grekov:\u001b[0m "]
