[0.275277, "o", "SEE INTERVIEW #699607\r\n"]
[0.276398, "o", "\u001b[?2004h\u001b[32mstudent\u001b[33m@\u001b[34mi.grekov:\u001b[0m "]
[0.322926, "o", "cat interviews/interview-699607\r\n\u001b[?2004l\r"]
[0.326391, "o", "Interviewed Ms. Church at 2:04 pm.  Witness stated that she did not see anyone she could identify as the shooter, that she ran away as soon as the shots were fired.\r\n\r\nHowever, she reports seeing the car that fled the scene.  Describes it as a blue Honda, with a license plate that starts with \"L337\" and ends with \"9\"\r\n"]
[0.327275, "o", "\u001b[?2004h"]
[0.328244, "o", "\u001b[32mstudent\u001b[33m@\u001b[34mi.grekov:\u001b[0m "]
[0.373042, "o", "grep -A 5 'License Plate L337.*9' vehicles\r\n\u001b[?2004l\r"]
