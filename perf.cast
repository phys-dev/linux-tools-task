[0.00694, "o", "\u001b[?2004h\u001b[32mstudent\u001b[33m@\u001b[34mi.grekov:\u001b[0m "]
[0.015256, "o", "perf=$(find /usr/lib/linux-tools* -type f -name perf | sort -V | tail -1)\r\n\u001b[?2004l\r"]
[0.021067, "o", "\u001b[?2004h\u001b[32mstudent\u001b[33m@\u001b[34mi.grekov:\u001b[0m "]
[0.0661, "o", "sysctl kernel.perf_event_paranoid\r\n\u001b[?2004l\r"]
[0.070075, "o", "kernel.perf_event_paranoid = 4\r\n"]
[0.071108, "o", "\u001b[?2004h"]
[0.071662, "o", "\u001b[32mstudent\u001b[33m@\u001b[34mi.grekov:\u001b[0m "]
[0.117133, "o", "sudo \"$perf\" record -e cpu-clock -g -o ~/lab/perf.data -- python3 -c 'sum(i*i for i in range(10000000))'\r\n\u001b[?2004l\r"]
[1.385567, "o", "[ perf record: Woken up 1 times to write data ]\r\n"]
[1.392453, "o", "[ perf record: Captured and wrote 0.111 MB /home/student/lab/perf.data (604 samples) ]\r\n"]
[1.567168, "o", "\u001b[?2004h\u001b[32mstudent\u001b[33m@\u001b[34mi.grekov:\u001b[0m "]
[1.578009, "o", "sudo env PERF_PAGER=cat \"$perf\" report --stdio -i ~/lab/perf.data --percent-limit 3\r\n\u001b[?2004l\r"]
